{
  "name": "docker-mutagen",
  "version": "1.0.2",
  "description": "Synchronizacja repozytorium z kontenerem Dockera przez mutagena: sesja one-way-safe plus wyjątki two-way-safe dla plików zapisywanych w kontenerze",
  "author": "Jacek Karczmarczyk",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacekkarczmarczyk/docker-mutagen.git"
  },
  "keywords": [
    "docker",
    "mutagen",
    "sync",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "docker-mutagen": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "default": "./bin/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "git diff --name-status --exit-code HEAD && pnpm run lint && pnpm run build && cz-update-version && git add . && cz-commit --push --push-tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "cz-deploy": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "neostandard": "^0.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.71.0"
  }
}
